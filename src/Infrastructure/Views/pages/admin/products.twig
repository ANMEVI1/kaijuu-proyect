{% extends 'layouts/base.twig' %}

{% block content %}
<!-- Security Check for Admin -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    const sessionStr = localStorage.getItem('kaijuu_session');
    if (!sessionStr) {
        window.location.href = '/';
        return;
    }
    const session = JSON.parse(sessionStr);
    if (session.email !== 'admin_kaijuu@gmail.com') {
        alert('ACCESO DENEGADO. Nivel de Ki insuficiente.');
        window.location.href = '/';
    }
});
</script>

<div class="admin-layout" style="background: var(--clr-bg); font-family: var(--font-body); position: relative; z-index: 9999;">
  
  <!-- Admin Sidebar -->
  <aside class="admin-sidebar">
    <h2 style="font-family: var(--font-comic); font-size: 2rem; color: var(--clr-yellow); text-shadow: 2px 2px 0 var(--clr-red); transform: skewX(-5deg); margin-bottom: 2rem; text-align: center; letter-spacing: 2px;">PANEL ADMIN</h2>
    
    <nav style="display: flex; flex-direction: column; gap: 1rem;">
      <a href="/admin" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">📊 DASHBOARD</a>
      <a href="/admin/productos" class="btn-comic" style="background: var(--clr-cyan); width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">📦 PRODUCTOS</a>
      <a href="/admin/categorias" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">🏷️ CATEGORÍAS</a>
      <a href="/admin/pedidos" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">🛒 PEDIDOS</a>
      <a href="/admin/usuarios" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">👥 USUARIOS</a>
      <a href="/admin/monedero" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">🪙 MONEDERO ZEN</a>
    </nav>

    <div class="mt-auto" style="margin-top: auto;">
      <a href="/" class="btn-comic" style="background: var(--clr-red); width: 100%; font-size: 1rem; display: block; text-align: center; text-decoration: none;">🚪 VOLVER A TIENDA</a>
    </div>
  </aside>

  <!-- Admin Main Content -->
  <main class="admin-main">
      
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 2rem; background: var(--clr-white); border: 4px solid #000; box-shadow: 6px 6px 0 rgba(0,0,0,0.5); padding: 1.5rem; transform: skewX(-1deg);">
        <h1 style="font-family: var(--font-comic); font-size: 2.5rem; color: #000; margin: 0; line-height: 1;">GESTIÓN DE PRODUCTOS</h1>
        <a href="/admin/productos/nuevo" class="btn-comic btn-comic--green" style="color: #fff; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; gap: 10px; text-shadow: 2px 2px 0 #000; width: auto; padding: 10px 20px; text-decoration: none;">
          <span style="font-size: 1.5rem; text-shadow: none;">➕</span> NUEVO PRODUCTO
        </a>
      </div>

      <!-- Products Table -->
      <div class="admin-table-container">
        <table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-weight: bold; min-width: 800px;">
          <thead style="background: #000; color: var(--clr-white);">
            <tr>
              <th style="padding: 10px; text-align: left; border: 2px solid #000;">ID</th>
              <th style="padding: 10px; text-align: left; border: 2px solid #000;">IMAGEN</th>
              <th style="padding: 10px; text-align: left; border: 2px solid #000;">NOMBRE</th>
              <th style="padding: 10px; text-align: left; border: 2px solid #000;">PRECIO</th>
              <th style="padding: 10px; text-align: left; border: 2px solid #000;">STOCK</th>
              <th style="padding: 10px; text-align: center; border: 2px solid #000;">ACCIONES</th>
            </tr>
          </thead>
          <tbody>
            {% for p in products %}
              <tr style="{{ loop.index0 is odd ? 'background: #f9f9f9;' : '' }}">
                <td style="padding: 10px; border: 2px solid #000; font-size: 0.9rem;">{{ p.id|slice(0, 8) }}...</td>
                <td style="padding: 10px; border: 2px solid #000;">
                  <img src="{{ p.imageUrl ?: '/assets/img/hero-manga.jpg' }}" style="width: 50px; height: 50px; object-fit: cover; border: 2px solid #000;">
                </td>
                <td style="padding: 10px; border: 2px solid #000;">{{ p.name }}</td>
                <td style="padding: 10px; border: 2px solid #000; color: var(--clr-orange);">{{ p.price }} Z</td>
                <td style="padding: 10px; border: 2px solid #000;">{{ p.stock }}</td>
                <td style="padding: 10px; border: 2px solid #000; text-align: center;">
                  <div style="display: flex; gap: 5px; justify-content: center;">
                    <a href="/admin/productos/{{ p.id }}/editar" class="btn-comic" style="background: var(--clr-cyan); padding: 5px 10px; font-size: 0.9rem; text-decoration: none; color: #fff; text-shadow: none;">✏️</a>
                    <form method="POST" action="/admin/productos/{{ p.id }}/eliminar" style="margin: 0;" onsubmit="return confirm('¿Seguro que deseas eliminar este producto?');">
                      <button type="submit" class="btn-comic" style="background: var(--clr-red); padding: 5px 10px; font-size: 0.9rem; color: #fff; text-shadow: none; cursor: pointer;">🗑️</button>
                    </form>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="6" style="padding: 20px; text-align: center; color: #666;">No hay productos. ¡Crea uno!</td></tr>
            {% endfor %}
          </tbody>
        </table>
      <!-- Paginación Comic -->
      {% if totalPages is defined and totalPages > 1 %}
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; background: #000; padding: 1rem; border: 3px solid var(--clr-cyan); transform: skewX(-2deg);">
        {% if currentPage > 1 %}
          <a href="?page={{ currentPage - 1 }}" class="btn-comic" style="background: var(--clr-yellow); color: #000; text-decoration: none;">← ANTERIOR</a>
        {% else %}
          <span class="btn-comic" style="background: #555; color: #888; cursor: not-allowed;">← ANTERIOR</span>
        {% endif %}

        <span style="font-family: var(--font-comic); font-size: 1.2rem; color: var(--clr-yellow);">
          PÁGINA {{ currentPage }} DE {{ totalPages }}
        </span>

        {% if currentPage < totalPages %}
          <a href="?page={{ currentPage + 1 }}" class="btn-comic" style="background: var(--clr-yellow); color: #000; text-decoration: none;">SIGUIENTE →</a>
        {% else %}
          <span class="btn-comic" style="background: #555; color: #888; cursor: not-allowed;">SIGUIENTE →</span>
        {% endif %}
      </div>
      {% endif %}

    </main>
</div>
{% endblock %}
