{% extends 'layouts/base.twig' %}

{% block content %}
<div class="admin-layout" style="background: var(--clr-bg); font-family: var(--font-body); position: relative; z-index: 9999;">
  
  <aside class="admin-sidebar">
    <h2 style="font-family: var(--font-comic); font-size: 2rem; color: var(--clr-yellow); text-shadow: 2px 2px 0 var(--clr-red); transform: skewX(-5deg); margin-bottom: 2rem; text-align: center; letter-spacing: 2px;">PANEL ADMIN</h2>
    
    <nav style="display: flex; flex-direction: column; gap: 1rem;">
      <a href="/admin" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">📊 DASHBOARD</a>
      <a href="/admin/productos" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">📦 PRODUCTOS</a>
      <a href="/admin/categorias" class="btn-comic" style="background: var(--clr-cyan); width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">🏷️ CATEGORÍAS</a>
      <a href="/admin/pedidos" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">🛒 PEDIDOS</a>
      <a href="/admin/usuarios" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">👥 USUARIOS</a>
      <a href="/admin/monedero" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">🪙 MONEDERO ZEN</a>
    </nav>

    <div class="mt-auto" style="margin-top: auto;">
      <a href="/" class="btn-comic" style="background: var(--clr-red); width: 100%; font-size: 1rem; display: block; text-align: center; text-decoration: none;">🚪 VOLVER A TIENDA</a>
    </div>
  </aside>

  <main class="admin-main">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 2rem; background: var(--clr-white); border: 4px solid #000; box-shadow: 6px 6px 0 rgba(0,0,0,0.5); padding: 1.5rem; transform: skewX(-1deg);">
        <h1 style="font-family: var(--font-comic); font-size: 2.5rem; color: #000; margin: 0; line-height: 1;">GESTIÓN DE CATEGORÍAS</h1>
        <a href="/admin/categorias/nueva" class="btn-comic btn-comic--green" style="color: #fff; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; gap: 10px; text-shadow: 2px 2px 0 #000; width: auto; padding: 10px 20px; text-decoration: none;">
          <span style="font-size: 1.5rem; text-shadow: none;">➕</span> NUEVA CATEGORÍA
        </a>
      </div>

      <div class="admin-table-container">
        <table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-weight: bold; min-width: 600px; border: 4px solid #000;">
          <thead style="background: #000; color: var(--clr-white); font-family: var(--font-comic); font-size: 1.1rem;">
            <tr>
              <th style="padding: 12px; text-align: left; border: 2px solid #000;">ID</th>
              <th style="padding: 12px; text-align: left; border: 2px solid #000;">NOMBRE</th>
              <th style="padding: 12px; text-align: left; border: 2px solid #000;">SLUG</th>
              <th style="padding: 12px; text-align: center; border: 2px solid #000;">ACCIONES</th>
            </tr>
          </thead>
          <tbody>
            {% for c in categories %}
              {% set cId = c.id is defined ? c.id : c['id'] %}
              {% set cName = c.name is defined ? c.name : c['name'] %}
              {% set cSlug = c.slug is defined ? c.slug : c['slug'] %}
              <tr style="{{ loop.index0 is odd ? 'background: #f9f9f9;' : 'background: #fff;' }}">
                <td style="padding: 12px; border: 2px solid #000; font-size: 0.9rem;">{{ cId|slice(0, 8) }}...</td>
                <td style="padding: 12px; border: 2px solid #000; font-family: var(--font-comic); font-size: 1.2rem; color: #000;">{{ cName }}</td>
                <td style="padding: 12px; border: 2px solid #000; color: var(--clr-red); font-family: monospace;">{{ cSlug }}</td>
                <td style="padding: 12px; border: 2px solid #000; text-align: center;">
                  <div style="display: flex; gap: 8px; justify-content: center;">
                    <a href="/admin/categorias/{{ cId }}/editar" class="btn-comic" style="background: var(--clr-cyan); padding: 6px 12px; font-size: 1rem; text-decoration: none; color: #fff;">✏️ EDITAR</a>
                    <form method="POST" action="/admin/categorias/{{ cId }}/eliminar" style="margin: 0;" onsubmit="return confirm('¿Seguro que deseas eliminar esta categoría?');">
                      <button type="submit" class="btn-comic" style="background: var(--clr-red); padding: 6px 12px; font-size: 1rem; color: #fff; cursor: pointer;">🗑️</button>
                    </form>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="4" style="padding: 25px; text-align: center; font-family: var(--font-comic); font-size: 1.2rem; color: #666;">No hay categorías registradas. ¡Crea una nueva!</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

  </main>
</div>
{% endblock %}
