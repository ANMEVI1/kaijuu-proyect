{% extends 'layouts/base.twig' %}

{% block content %}
<!-- Security Check for Admin -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    const sessionStr = localStorage.getItem('kaijuu_session');
    if (!sessionStr) {
        window.location.href = '/';
        return;
    }
    const session = JSON.parse(sessionStr);
    // Since we created the admin via API, the role might be inside app_metadata or we trust the email for now
    // Supabase JWT stores app_metadata.role or user_metadata
    // For simplicity in this demo, if it's the admin email, we allow it.
    if (session.email !== 'admin_kaijuu@gmail.com') {
        alert('ACCESO DENEGADO. Nivel de Ki insuficiente.');
        window.location.href = '/';
    }
});
</script>

<div class="admin-layout" style="background: var(--clr-bg); font-family: var(--font-body); position: relative; z-index: 9999;">
  
  <!-- Admin Sidebar -->
  <aside class="admin-sidebar">
    <h2 style="font-family: var(--font-comic); font-size: 2rem; color: var(--clr-yellow); text-shadow: 2px 2px 0 var(--clr-red); transform: skewX(-5deg); margin-bottom: 2rem; text-align: center; letter-spacing: 2px;">PANEL ADMIN</h2>
    
    <nav style="display: flex; flex-direction: column; gap: 1rem;">
      <a href="/admin" class="btn-comic" style="background: var(--clr-cyan); width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">📊 DASHBOARD</a>
      <a href="/admin/productos" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">📦 PRODUCTOS</a>
      <a href="/admin/categorias" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">🏷️ CATEGORÍAS</a>
      <a href="/admin/pedidos" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">🛒 PEDIDOS</a>
      <a href="/admin/usuarios" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">👥 USUARIOS</a>
      <a href="/admin/monedero" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; width: 100%; font-size: 1.2rem; display: block; text-align: center; text-decoration: none;">🪙 MONEDERO ZEN</a>
    </nav>

    <div class="mt-auto" style="margin-top: auto;">
      <a href="/" class="btn-comic" style="background: var(--clr-red); width: 100%; font-size: 1rem; display: block; text-align: center; text-decoration: none;">🚪 VOLVER A TIENDA</a>
    </div>
  </aside>

  <!-- Admin Main Content -->
  <main class="admin-main">
    <!-- Welcome Header -->
    <div style="background: var(--clr-white); border: 4px solid #000; box-shadow: 6px 6px 0 rgba(0,0,0,0.5); padding: 1.5rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; transform: skewX(-1deg);">
      <div>
        <h1 style="font-family: var(--font-comic); font-size: 2.5rem; color: #000; margin: 0; line-height: 1;">BIENVENIDO, SUPREMO KAIO-SAMA</h1>
        <p style="margin: 0; color: #666; font-weight: bold; margin-top: 5px;">Aquí controlas el multiverso de Kaijuu Store.</p>
      </div>
      <div>
        <img src="https://ui-avatars.com/api/?name=Admin&background=0D8ABC&color=fff" alt="Admin" style="width: 70px; height: 70px; border-radius: 50%; border: 3px solid #000;">
      </div>
    </div>

    <!-- Stats Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
      <div style="background: var(--clr-cyan); border: 4px solid #000; box-shadow: 4px 4px 0 #000; padding: 1.5rem; transform: skewX(-2deg);">
        <h3 style="font-family: var(--font-comic); font-size: 1.5rem; margin: 0; color: var(--clr-white); text-shadow: 1px 1px 0 #000;">VENTAS TOTALES</h3>
        <p style="font-family: var(--font-body); font-size: 2.5rem; font-weight: 900; margin: 10px 0 0; color: #000;">{{ stats.total_sales }} Z</p>
      </div>
      <div style="background: var(--clr-yellow); border: 4px solid #000; box-shadow: 4px 4px 0 #000; padding: 1.5rem; transform: skewX(-2deg);">
        <h3 style="font-family: var(--font-comic); font-size: 1.5rem; margin: 0; color: #000;">PEDIDOS</h3>
        <p style="font-family: var(--font-body); font-size: 2.5rem; font-weight: 900; margin: 10px 0 0; color: #000;">{{ stats.orders_count }}</p>
      </div>
      <div style="background: var(--clr-orange); border: 4px solid #000; box-shadow: 4px 4px 0 #000; padding: 1.5rem; transform: skewX(-2deg);">
        <h3 style="font-family: var(--font-comic); font-size: 1.5rem; margin: 0; color: #000;">PRODUCTOS</h3>
        <p style="font-family: var(--font-body); font-size: 2.5rem; font-weight: 900; margin: 10px 0 0; color: #000;">{{ stats.products_count }}</p>
      </div>
      <div style="background: var(--clr-green); border: 4px solid #000; box-shadow: 4px 4px 0 #000; padding: 1.5rem; transform: skewX(-2deg);">
        <h3 style="font-family: var(--font-comic); font-size: 1.5rem; margin: 0; color: #000;">USUARIOS</h3>
        <p style="font-family: var(--font-body); font-size: 2.5rem; font-weight: 900; margin: 10px 0 0; color: #000;">{{ stats.users_count }}</p>
      </div>
    </div>

    <!-- Recent Activity Placeholder -->
    <div style="background: var(--clr-white); border: 4px solid #000; box-shadow: 6px 6px 0 rgba(0,0,0,0.5); padding: 1.5rem; transform: skewX(-1deg);">
      <h2 style="font-family: var(--font-comic); font-size: 2rem; color: #000; margin-top: 0; border-bottom: 4px solid #000; padding-bottom: 10px;">ACTIVIDAD RECIENTE</h2>
      <div style="padding: 2rem; text-align: center; font-family: var(--font-body); font-size: 1.2rem; font-weight: bold; margin-top: 1rem;">
        <p>Próximamente: Historial de actividad y pedidos recientes.</p>
      </div>
    </div>

  </main>
</div>
{% endblock %}
