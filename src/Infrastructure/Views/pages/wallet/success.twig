{% extends 'layouts/base.twig' %}

{% block content %}
<div style="max-width: 650px; margin: 4rem auto; text-align: center; background: var(--clr-white); border: 4px solid #000; box-shadow: 10px 10px 0 rgba(0,0,0,0.8); padding: 3rem; transform: skewX(-2deg); position: relative; overflow: hidden;">
    
    <div style="position: absolute; top: -20px; right: -20px; background: var(--clr-yellow); border: 3px solid #000; padding: 10px 20px; font-family: var(--font-comic); font-size: 1.2rem; transform: rotate(15deg); font-weight: bold; box-shadow: 4px 4px 0 #000;">
        ⚡ EXITO Z!
    </div>

    <div style="font-size: 5.5rem; margin-bottom: 1rem; filter: drop-shadow(4px 4px 0 #000);">🎉</div>
    
    <h1 style="font-family: var(--font-comic); font-size: 3.2rem; margin: 0; color: var(--clr-green); text-shadow: 3px 3px 0 #000; text-transform: uppercase;">¡RECARGA EXITOSA!</h1>
    
    <p style="font-family: var(--font-comic); font-size: 1.4rem; color: #000; margin-top: 1.5rem; line-height: 1.6;">
        ¡Tus ZEN han sido acreditados a tu Monedero de Guerrero! 🪙<br>
        Ya puedes usarlos para adquirir cualquier producto del catálogo.
    </p>

    <div style="margin-top: 3rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/monedero" class="btn-comic btn-comic--green" style="text-decoration: none; font-size: 1.3rem;">🪙 MI MONEDERO</a>
        <a href="/catalogo" class="btn-comic" style="background: var(--clr-yellow); color: #000; text-decoration: none; font-size: 1.3rem;">🛒 IR AL CATÁLOGO</a>
    </div>

</div>
{% endblock %}
