{% extends 'layouts/base.twig' %}

{% block content %}
<div style="max-width: 1050px; margin: 2rem auto; padding: 2rem; background: var(--clr-white); border: 4px solid #000; box-shadow: 8px 8px 0 rgba(0,0,0,0.8); transform: skewX(-1deg);">
    
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 4px solid #000; padding-bottom: 1.2rem; margin-bottom: 2rem;">
        <h1 style="font-family: var(--font-comic); font-size: 2.8rem; margin: 0; color: #000; text-shadow: 2px 2px 0 var(--clr-yellow);">📜 HISTORIAL DE MONEDERO</h1>
        <a href="/monedero" class="btn-comic" style="background: var(--clr-yellow); color: #000; text-decoration: none; font-size: 1.2rem;">VOLVER AL MONEDERO</a>
    </div>

    <div style="overflow-x: auto; margin-bottom: 2rem;">
        <table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-weight: bold; border: 4px solid #000;">
            <thead style="background: #000; color: var(--clr-white); font-family: var(--font-comic); font-size: 1.1rem;">
                <tr>
                    <th style="padding: 12px; border: 2px solid #000; text-align: left;">FECHA</th>
                    <th style="padding: 12px; border: 2px solid #000; text-align: left;">TIPO</th>
                    <th style="padding: 12px; border: 2px solid #000; text-align: right;">MONTO (ZEN)</th>
                    <th style="padding: 12px; border: 2px solid #000; text-align: right;">SALDO RESULTANTE</th>
                    <th style="padding: 12px; border: 2px solid #000; text-align: center;">ESTADO</th>
                    <th style="padding: 12px; border: 2px solid #000; text-align: left;">REFERENCIA</th>
                </tr>
            </thead>
            <tbody>
                {% for tx in transactions %}
                    <tr style="{{ loop.index0 is odd ? 'background: #f4f4f4;' : 'background: #fff;' }}">
                        <td style="padding: 12px; border: 2px solid #000;">{{ tx.createdAt|date('d/m/Y H:i') }}</td>
                        <td style="padding: 12px; border: 2px solid #000; font-family: var(--font-comic); text-transform: uppercase;">{{ tx.type }}</td>
                        <td style="padding: 12px; border: 2px solid #000; text-align: right; font-family: var(--font-comic); font-size: 1.2rem; color: {{ tx.direction == 'credito' ? 'var(--clr-green)' : 'var(--clr-red)' }}; text-shadow: 1px 1px 0 #000;">
                            {{ tx.direction == 'credito' ? '+' : '-' }}{{ tx.amountZen|number_format(2) }} ZEN
                        </td>
                        <td style="padding: 12px; border: 2px solid #000; text-align: right; font-family: var(--font-comic);">
                            {{ tx.balanceAfter|number_format(2) }} ZEN
                        </td>
                        <td style="padding: 12px; border: 2px solid #000; text-align: center;">
                            <span style="background: {{ tx.status == 'pendiente' ? 'var(--clr-yellow)' : (tx.status == 'completado' ? 'var(--clr-green)' : 'var(--clr-red)') }}; color: #000; padding: 4px 10px; font-family: var(--font-comic); font-size: 0.9rem; border: 2px solid #000; box-shadow: 2px 2px 0 #000; font-weight: bold;">
                                {{ tx.status|upper }}
                            </span>
                        </td>
                        <td style="padding: 12px; border: 2px solid #000; font-size: 0.85rem; color: #555;">
                            {{ tx.referenceCode ?: (tx.orderId ? 'Pedido: ' ~ tx.orderId|slice(0,8) : '-') }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" style="padding: 25px; text-align: center; font-family: var(--font-comic); font-size: 1.2rem; color: #666;">No hay transacciones registradas.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Paginación Comic -->
    {% if totalPages is defined and totalPages > 1 %}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; background: #000; padding: 1rem; border: 3px solid var(--clr-cyan); transform: skewX(-2deg);">
        {% if currentPage > 1 %}
            <a href="?page={{ currentPage - 1 }}" class="btn-comic" style="background: var(--clr-yellow); color: #000; text-decoration: none;">← ANTERIOR</a>
        {% else %}
            <span class="btn-comic" style="background: #555; color: #888; cursor: not-allowed;">← ANTERIOR</span>
        {% endif %}

        <span style="font-family: var(--font-comic); font-size: 1.3rem; color: var(--clr-yellow); text-shadow: 1px 1px 0 #000;">
            PÁGINA {{ currentPage }} DE {{ totalPages }}
        </span>

        {% if currentPage < totalPages %}
            <a href="?page={{ currentPage + 1 }}" class="btn-comic" style="background: var(--clr-yellow); color: #000; text-decoration: none;">SIGUIENTE →</a>
        {% else %}
            <span class="btn-comic" style="background: #555; color: #888; cursor: not-allowed;">SIGUIENTE →</span>
        {% endif %}
    </div>
    {% endif %}

</div>
{% endblock %}
