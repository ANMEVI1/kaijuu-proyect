{% extends 'layouts/base.twig' %}

{% block content %}
<div class="wallet-container" style="max-width: 900px; margin: 2rem auto; padding: 2rem; background: var(--clr-white); border: 4px solid #000; box-shadow: 8px 8px 0 rgba(0,0,0,0.8); transform: skewX(-1deg);">
    
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 4px solid #000; padding-bottom: 1.2rem; margin-bottom: 2rem;">
        <h1 style="font-family: var(--font-comic); font-size: 2.8rem; margin: 0; color: #000; text-shadow: 3px 3px 0 var(--clr-cyan);">🪙 MI MONEDERO ZEN</h1>
        <a href="/monedero/recargar" class="btn-comic btn-comic--green" style="font-size: 1.2rem; text-decoration: none;">➕ RECARGAR ZEN</a>
    </div>

    <!-- Saldo Card Comic Style -->
    <div style="background: #000; color: #fff; padding: 2.5rem; text-align: center; margin-bottom: 2.5rem; border: 4px solid var(--clr-yellow); box-shadow: 6px 6px 0 var(--clr-red); transform: skewX(-3deg);">
        <h2 style="font-family: var(--font-comic); font-size: 1.5rem; margin: 0; color: var(--clr-yellow); text-transform: uppercase; letter-spacing: 2px;">SALDO DISPONIBLE</h2>
        <div style="font-family: var(--font-comic); font-size: 4.5rem; line-height: 1.1; margin: 15px 0; color: var(--clr-cyan); text-shadow: 4px 4px 0 var(--clr-red);">
            {{ wallet.balanceZen|number_format(2) }} <span style="font-size: 2.5rem; color: var(--clr-yellow);">ZEN</span>
        </div>
        {% if rate %}
        <p style="font-family: var(--font-comic); font-size: 1.2rem; color: #fff; margin-bottom: 4px;">
            💵 EQUIVALENTE A: <strong style="color: var(--clr-green);">S/ {{ (wallet.balanceZen * rate.rate)|number_format(2) }} PEN</strong>
        </p>
        <p style="font-size: 0.9rem; font-family: var(--font-body); color: #aaa; margin: 0;">
            (Tipo de Cambio Oficial: 1 ZEN = S/ {{ rate.rate|number_format(2) }})
        </p>
        {% endif %}
    </div>

    <!-- Movimientos -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-family: var(--font-comic); font-size: 2rem; margin: 0; color: #000;">⚡ ÚLTIMOS MOVIMIENTOS</h3>
        <a href="/monedero/historial" class="btn-comic" style="background: var(--clr-yellow); color: #000; text-decoration: none; font-size: 1rem;">VER TODO</a>
    </div>
    
    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-weight: bold; border: 4px solid #000;">
            <thead style="background: #000; color: var(--clr-white); font-family: var(--font-comic); font-size: 1.1rem;">
                <tr>
                    <th style="padding: 12px; border: 2px solid #000; text-align: left;">FECHA</th>
                    <th style="padding: 12px; border: 2px solid #000; text-align: left;">TIPO</th>
                    <th style="padding: 12px; border: 2px solid #000; text-align: right;">MONTO (ZEN)</th>
                    <th style="padding: 12px; border: 2px solid #000; text-align: center;">ESTADO</th>
                </tr>
            </thead>
            <tbody>
                {% for tx in transactions %}
                    <tr style="{{ loop.index0 is odd ? 'background: #f4f4f4;' : 'background: #fff;' }}">
                        <td style="padding: 12px; border: 2px solid #000;">{{ tx.createdAt|date('d/m/Y H:i') }}</td>
                        <td style="padding: 12px; border: 2px solid #000; text-transform: uppercase; font-family: var(--font-comic);">{{ tx.type }}</td>
                        <td style="padding: 12px; border: 2px solid #000; text-align: right; font-family: var(--font-comic); font-size: 1.2rem; color: {{ tx.direction == 'credito' ? 'var(--clr-green)' : 'var(--clr-red)' }}; text-shadow: 1px 1px 0 #000;">
                            {{ tx.direction == 'credito' ? '+' : '-' }}{{ tx.amountZen|number_format(2) }} ZEN
                        </td>
                        <td style="padding: 12px; border: 2px solid #000; text-align: center;">
                            <span style="background: {{ tx.status == 'pendiente' ? 'var(--clr-yellow)' : (tx.status == 'completado' ? 'var(--clr-green)' : 'var(--clr-red)') }}; color: #000; padding: 4px 10px; font-family: var(--font-comic); font-size: 0.9rem; border: 2px solid #000; box-shadow: 2px 2px 0 #000; font-weight: bold;">
                                {{ tx.status|upper }}
                            </span>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" style="padding: 25px; text-align: center; font-family: var(--font-comic); font-size: 1.2rem; color: #666;">No hay movimientos recientes. ¡Haz tu primera recarga!</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% endblock %}
