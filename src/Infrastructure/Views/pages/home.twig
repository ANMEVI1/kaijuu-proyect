{% extends 'layouts/base.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div class="container">
  <div class="comic-layout">
    
    <!-- 1. Panel Izquierdo (Imágenes de relleno tipo cómic) -->
    <aside class="comic-panel comic-panel--blue" style="display:flex; flex-direction:column;">
      <div style="flex:1; border-bottom:var(--border-thick); overflow:hidden;">
        <img src="/assets/img/comic_panel_1.jpg" style="width:100%; height:100%; object-fit:cover; filter:grayscale(100%);" alt="Comic Panel 1">
      </div>
      <div style="flex:2; position:relative; overflow:hidden; background:var(--clr-magenta);">
        <img src="/assets/img/comic_panel_2.jpg" style="width:100%; height:100%; object-fit:cover; filter:grayscale(100%) contrast(150%); mix-blend-mode:multiply;" alt="Comic Panel 2">
        <h3 class="comic-title" style="position:absolute; bottom:10px; left:10px; transform:skewX(-10deg) rotate(-5deg); font-size:2.5rem; line-height:0.9;">KAMEHAMEHA!</h3>
      </div>
    </aside>

    <!-- 2. Columna Central (Main Content) -->
    <section class="main-content-col">
      <!-- Hero Banner -->
      <div class="hero-banner">
        <h1>¡EMPIEZA TU AVENTURA!</h1>
        <h2>¡EQUÍPATE COMO UN GUERRERO Z!</h2>
        <p style="font-family: var(--font-body); font-size: 1.2rem; color: var(--clr-white); margin-top: 10px; text-shadow: 2px 2px 0 #000; font-style: italic;">
          "Viste tu fandom. Domina tu colección."
        </p>
      </div>

      <!-- Category Tabs -->
      <div class="category-tabs">
        <a href="/categoria/mangas" class="category-tab tab-blue"><span>MANGAS</span></a>
        <a href="/categoria/figuras" class="category-tab tab-magenta"><span>FIGURAS</span></a>
        <a href="/categoria/ropa" class="category-tab tab-orange"><span>ROPA</span></a>
        <a href="/categoria/merch" class="category-tab tab-orange"><span>MERCH</span></a>
      </div>

      <!-- Products Grid -->
      <div class="products-grid" id="products-grid">
        {% if featured is empty %}
          <div class="comic-panel" style="padding:2rem; text-align:center;">
            <h3 class="comic-title" style="color:var(--clr-border); text-shadow:none;">AÚN NO HAY PRODUCTOS</h3>
          </div>
        {% else %}
          {% for product in featured %}
            {% include 'components/product-card.twig' with { product: product } %}
          {% endfor %}
        {% endif %}
      </div>
    </section>

    <!-- 3. Panel Derecho (New Arrivals) -->
    <aside class="sidebar-right">
      <div class="sidebar-panel">
        <div class="sidebar-panel__header">New Arrivals</div>
        <div class="sidebar-panel__content" style="display:grid; grid-template-columns:1fr 1fr; gap:10px; padding:10px;">
          <!-- Placeholder para New Arrivals -->
          <img src="/assets/img/arrival_1.jpg" style="width:100%; border:2px solid #000;" alt="New Arrival 1">
          <img src="/assets/img/arrival_2.jpg" style="width:100%; border:2px solid #000;" alt="New Arrival 2">
          <img src="/assets/img/arrival_3.jpg" style="width:100%; border:2px solid #000;" alt="New Arrival 3">
          <img src="/assets/img/arrival_4.jpg" style="width:100%; border:2px solid #000;" alt="New Arrival 4">
        </div>
      </div>
      
      <div class="sidebar-panel" style="background:var(--clr-green);">
        <div style="padding:1rem; text-align:center;">
          <h3 class="comic-title" style="font-size:2.5rem; margin-bottom:10px;">29P!</h3>
          <img src="/assets/img/cart_hero.jpg" style="width:100%; border:var(--border-med); margin-bottom:10px;" alt="Bolsa">
          <button class="btn-comic btn-comic--green" style="font-size:1.5rem;" id="open-bolsa-btn">
            <span>🛒 MI BOLSA (<span id="sidebar-cart-count">0</span>)</span>
          </button>
        </div>
      </div>
    </aside>

  </div>
</div>
{% endblock %}

{% block scripts %}
<script type="module" src="/assets/js/pages/home.js"></script>
<script>
  // Simple listener for the sidebar cart button
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('open-bolsa-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        document.getElementById('cart-toggle-btn')?.click();
      });
    }
  });
</script>
{% endblock %}
