<!-- Auth Modal -->
<div class="bolsa-modal" id="auth-modal" role="dialog" aria-modal="true" aria-label="Autenticación">
  <div class="bolsa-content auth-modal-content">
    <button class="bolsa-close" id="auth-close-btn" aria-label="Cerrar modal" style="color: var(--clr-white); text-shadow: 2px 2px 0 #000, -2px -2px 0 #000;">✕</button>
    
    <!-- Lado Izquierdo: Formularios -->
    <div class="auth-modal-overlay">
      
      <h2 class="bolsa-title" id="auth-title" style="font-size: 3.5rem; text-shadow: -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 2px 2px 0 #000, 4px 4px 0 #000; color: var(--clr-white); transform: skewX(-5deg) rotate(-2deg); margin-bottom: 2rem; text-align: center; line-height: 1;">
        ¡INICIA TU<br>AVENTURA!
      </h2>

      <!-- Login Form -->
      <form id="login-form" class="auth-form" style="display: flex; flex-direction: column; gap: 1rem;">
        
        <!-- Input Group: Email -->
        <div class="auth-input-group">
          <label style="font-family: var(--font-comic); font-size: 1.1rem; color: var(--clr-white); text-shadow: 2px 2px 0 #000; margin-bottom: 0.2rem; display: block; text-align: center;">NOMBRE DE GUERRERO (EMAIL)</label>
          <div style="display: flex; border: 3px solid #000; box-shadow: 4px 4px 0 rgba(0,0,0,0.5); transform: skewX(-5deg); background: var(--clr-white);">
            <div style="background: var(--clr-bg); color: var(--clr-white); width: 50px; display: flex; justify-content: center; align-items: center; border-right: 3px solid #000; font-size: 1.5rem;">
              悟
            </div>
            <input type="email" name="email" required placeholder="tu-email@kaijuu.com" style="flex: 1; padding: 0.8rem; border: none; font-family: var(--font-body); font-size: 1rem; outline: none; background: transparent; transform: skewX(5deg);">
          </div>
        </div>

        <!-- Input Group: Password -->
        <div class="auth-input-group">
          <label style="font-family: var(--font-comic); font-size: 1.1rem; color: var(--clr-white); text-shadow: 2px 2px 0 #000; margin-bottom: 0.2rem; display: block; text-align: center;">CONTRASEÑA</label>
          <div style="display: flex; border: 3px solid #000; box-shadow: 4px 4px 0 rgba(0,0,0,0.5); transform: skewX(-5deg); background: var(--clr-white); position: relative;">
            <div style="background: var(--clr-blue); color: var(--clr-white); width: 50px; display: flex; justify-content: center; align-items: center; border-right: 3px solid #000; font-size: 1.5rem;">
              🔑
            </div>
            <input type="password" name="password" required placeholder="*********" style="flex: 1; padding: 0.8rem; padding-right: 3rem; border: none; font-family: var(--font-body); font-size: 1rem; outline: none; background: transparent; transform: skewX(5deg);">
            <button type="button" class="toggle-password" style="position: absolute; right: 5px; top: 50%; transform: translateY(-50%) skewX(5deg); background: none; border: none; font-size: 1.2rem; cursor: pointer;" aria-label="Mostrar contraseña">👁️</button>
          </div>
        </div>

        <!-- Botón Iniciar Sesión -->
        <div style="display: flex; align-items: center; margin-top: 1rem; position: relative;">
          <button type="submit" class="btn-comic" style="background: var(--clr-orange); width: 70%; padding: 1rem; font-size: 1.8rem; transform: skewX(-10deg) scale(1.05); z-index: 2;">
            <span>INICIAR SESIÓN</span>
          </button>
          <!-- Fireball Effect Text -->
          <div style="position: absolute; right: -80px; font-family: var(--font-comic); font-size: 2rem; color: #000; text-shadow: 2px 2px 0 var(--clr-yellow), -2px -2px 0 var(--clr-white); transform: rotate(-5deg); z-index: 3; pointer-events: none;">
            ¡ENTRAR! ⚡
          </div>
        </div>

        <!-- Botón Google -->
        <button type="button" id="btn-google-login" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 0.8rem; margin-top: 0.5rem; transform: skewX(-5deg);">
          <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" style="width: 25px; height: 25px;">
          <span style="font-size: 1.2rem;">CONTINUAR CON GOOGLE</span>
        </button>

        <!-- Links Inferiores -->
        <div style="display: flex; justify-content: space-between; margin-top: 1.5rem; font-family: var(--font-comic); font-size: 1.1rem;">
          <a href="#" id="go-to-register" style="color: var(--clr-white); text-decoration: underline; text-shadow: 1px 1px 0 #000;">CREAR CUENTA Z</a>
          <a href="#" style="color: var(--clr-white); text-decoration: underline; text-shadow: 1px 1px 0 #000;">¿OLVIDASTE TU POWER UP?</a>
        </div>
      </form>

      <!-- Register Form (Oculto por defecto) -->
      <form id="register-form" class="auth-form" style="display: none; flex-direction: column; gap: 0.8rem;">
        
        <div class="auth-input-group">
          <label style="font-family: var(--font-comic); font-size: 1rem; color: var(--clr-white); text-shadow: 2px 2px 0 #000; margin-bottom: 0.1rem; display: block; text-align: center;">NOMBRE DE GUERRERO (EMAIL)</label>
          <div style="display: flex; border: 3px solid #000; box-shadow: 4px 4px 0 rgba(0,0,0,0.5); transform: skewX(-5deg); background: var(--clr-white);">
            <div style="background: var(--clr-bg); color: var(--clr-white); width: 40px; display: flex; justify-content: center; align-items: center; border-right: 3px solid #000; font-size: 1.2rem;">悟</div>
            <input type="email" name="email" required placeholder="tu-email@kaijuu.com" style="flex: 1; padding: 0.6rem; border: none; font-family: var(--font-body); font-size: 1rem; outline: none; background: transparent; transform: skewX(5deg);">
          </div>
        </div>

        <div class="auth-input-group">
          <label style="font-family: var(--font-comic); font-size: 1rem; color: var(--clr-white); text-shadow: 2px 2px 0 #000; margin-bottom: 0.1rem; display: block; text-align: center;">CONTRASEÑA</label>
          <div style="display: flex; border: 3px solid #000; box-shadow: 4px 4px 0 rgba(0,0,0,0.5); transform: skewX(-5deg); background: var(--clr-white); position: relative;">
            <div style="background: var(--clr-blue); color: var(--clr-white); width: 40px; display: flex; justify-content: center; align-items: center; border-right: 3px solid #000; font-size: 1.2rem;">🔑</div>
            <input type="password" name="password" id="reg-password" required minlength="6" placeholder="Mínimo 6 chars" style="flex: 1; padding: 0.6rem; padding-right: 2.5rem; border: none; font-family: var(--font-body); font-size: 1rem; outline: none; background: transparent; transform: skewX(5deg);">
            <button type="button" class="toggle-password" style="position: absolute; right: 5px; top: 50%; transform: translateY(-50%) skewX(5deg); background: none; border: none; font-size: 1.2rem; cursor: pointer;">👁️</button>
          </div>
          <small style="color: var(--clr-yellow); display: none; text-shadow: 1px 1px 0 #000;" id="pwd-error">Mínimo 6 caracteres.</small>
        </div>

        <div class="auth-input-group">
          <label style="font-family: var(--font-comic); font-size: 1rem; color: var(--clr-white); text-shadow: 2px 2px 0 #000; margin-bottom: 0.1rem; display: block; text-align: center;">CONFIRMAR CONTRASEÑA</label>
          <div style="display: flex; border: 3px solid #000; box-shadow: 4px 4px 0 rgba(0,0,0,0.5); transform: skewX(-5deg); background: var(--clr-white); position: relative;">
            <div style="background: var(--clr-blue); color: var(--clr-white); width: 40px; display: flex; justify-content: center; align-items: center; border-right: 3px solid #000; font-size: 1.2rem;">🔑</div>
            <input type="password" name="confirm_password" id="reg-confirm" required placeholder="Repite tu contraseña" style="flex: 1; padding: 0.6rem; padding-right: 2.5rem; border: none; font-family: var(--font-body); font-size: 1rem; outline: none; background: transparent; transform: skewX(5deg);">
            <button type="button" class="toggle-password" style="position: absolute; right: 5px; top: 50%; transform: translateY(-50%) skewX(5deg); background: none; border: none; font-size: 1.2rem; cursor: pointer;">👁️</button>
          </div>
          <small style="color: var(--clr-yellow); display: none; text-shadow: 1px 1px 0 #000;" id="confirm-error">Las contraseñas no coinciden.</small>
        </div>

        <div style="display: flex; align-items: center; margin-top: 1rem; position: relative;">
          <button type="submit" class="btn-comic" style="background: var(--clr-magenta); width: 70%; padding: 1rem; font-size: 1.5rem; transform: skewX(-10deg) scale(1.05); z-index: 2;">
            <span>CREAR CUENTA Z</span>
          </button>
          <div style="position: absolute; right: -60px; font-family: var(--font-comic); font-size: 1.8rem; color: #000; text-shadow: 2px 2px 0 var(--clr-cyan), -2px -2px 0 var(--clr-white); transform: rotate(5deg); z-index: 3; pointer-events: none;">
            ¡VAMOS! 🔥
          </div>
        </div>

        <!-- Botón Google -->
        <button type="button" id="btn-google-register" class="btn-comic" style="background: var(--clr-white); color: #000; text-shadow: none; display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 0.8rem; margin-top: 0.5rem; transform: skewX(-5deg);">
          <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" style="width: 25px; height: 25px;">
          <span style="font-size: 1.2rem;">CONTINUAR CON GOOGLE</span>
        </button>

        <div style="display: flex; justify-content: center; margin-top: 1rem; font-family: var(--font-comic); font-size: 1.1rem;">
          <a href="#" id="go-to-login" style="color: var(--clr-white); text-decoration: underline; text-shadow: 1px 1px 0 #000;">Volver a INICIAR SESIÓN</a>
        </div>
      </form>

    </div>
  </div>
</div>
