<div class="bolsa-modal" id="cart-sidebar" role="dialog" aria-modal="true" aria-label="Mi Bolsa Z">
  <div class="bolsa-content">
    <button class="bolsa-close" id="cart-close-btn" aria-label="Cerrar bolsa">✕</button>
    
    <div class="bolsa-header">
      <h2 class="bolsa-title">MI BOLSA Z</h2>
    </div>

    <div class="bolsa-items" id="cart-items">
      <!-- Renderizado por cart.js -->
    </div>

    <div class="bolsa-footer">
      <div class="bolsa-total">
        TOTAL: <span id="cart-total">0 Zeni</span>
      </div>
      <div style="display:flex; gap:1rem;">
        <button class="btn-comic" style="font-size:2rem; padding: 1rem 2rem;" id="cart-continue-btn">
          <span>¡SEGUIR BUSCANDO!</span>
        </button>
        <a href="/checkout" class="btn-comic" style="font-size:2rem; padding: 1rem 2rem;">
          <span>¡IR A CAJA! ⚡</span>
        </a>
      </div>
    </div>
  </div>
</div>
